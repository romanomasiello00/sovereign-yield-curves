# Python
__pycache__/
*.py[cod]
*.egg-info/
env/
venv/
.venv/

# Data (track metadata and processed but not raw by default)
data/raw/*.csv
data/raw/*.zip
data/raw/*.xlsx
data/raw/*.ods
data/raw/*.json
data/raw/*.html
!data/raw/.gitkeep

# Stray iCloud conflict copies
*\ 2.parquet
*\ 2.duckdb

# DuckDB (regenerated from Parquet on sync via sync_duckdb_after_write)
*.duckdb
*.duckdb.wal
*.tmp

# BDS raw downloads (large, regenerated from A2A API)
data/bds/raw/
!data/bds/raw/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Pytest
.pytest_cache/

# Ruff
.ruff_cache/

# Mypy
.mypy_cache/
